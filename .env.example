# Copia questo file in ".env" e compila.

# OBBLIGATORIO. Client token Mapillary, inizia con MLY|
# Si ottiene su https://www.mapillary.com/dashboard/developers
#   -> Register application -> apri l'app -> copia "Client token"
MAPILLARY_TOKEN=

# Porta del server. Su Render/Fly viene impostata dalla piattaforma.
PORT=3000

# FACOLTATIVO ma consigliato se pubblichi il gioco su internet.
# Se valorizzato, per creare o entrare in una stanza serve anche questa
# parola d'ordine: impedisce agli estranei di consumare la tua quota Mapillary.
GATE_CODE=

# Spegne il campionato permanente. Serve solo dove il disco viene azzerato a
# ogni riavvio, per esempio sul piano gratuito di Render.
# ALBO_OFF=1

# Dove finiscono le copie di sicurezza dell'albo (default: data/storico).
# ALBO_BACKUP_DIR=

# Solo per provare l'interfaccia senza token: localita' finte, panorama nero.
# FAKE_LOCATIONS=1
