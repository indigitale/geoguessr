[Unit]
Description=GeoDuello — gioco di geografia in famiglia
Documentation=file:/opt/geoduello/README.md
After=network-online.target
Wants=network-online.target
# Se muore in continuazione, non riavviarlo all'infinito
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=geoduello
Group=geoduello
WorkingDirectory=/opt/geoduello
EnvironmentFile=/opt/geoduello/.env
ExecStart=/usr/bin/env node server/index.js
Restart=always
RestartSec=5

# Irrobustimento: il gioco non ha bisogno di quasi nulla del sistema
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# unica cartella scrivibile: quella dell'albo d'oro
ReadWritePaths=/opt/geoduello/data

# I log finiscono nel journal: journalctl -u geoduello -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
